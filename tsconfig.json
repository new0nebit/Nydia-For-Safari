{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom"],
    "moduleResolution": "bundler",
    "types": ["firefox-webext-browser"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
